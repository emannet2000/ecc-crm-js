PORT=3000
DB=ecc.db
JWT_SECRET=replace-with-a-long-random-private-secret
PUBLIC_BASE_URL=http://localhost:3000
# Leave EMAIL_PROVIDER blank to queue messages without sending.
EMAIL_PROVIDER=
EMAIL_FROM=
# Resend: EMAIL_PROVIDER=resend, verified EMAIL_FROM, and RESEND_API_KEY.
RESEND_API_KEY=
# Gateway: EMAIL_PROVIDER=webhook, URL, and optional bearer token.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
MFA_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
BACKUP_INTERVAL_MINUTES=1440
BACKUP_RETENTION=14
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRUST_PROXY=0

# Optional local document processors (install and maintain on the application host).
# If a scanner is configured, uploads fail closed when scanning fails.
# DOCUMENT_SCANNER_COMMAND=/usr/bin/clamscan
# DOCUMENT_OCR_COMMAND=/usr/bin/tesseract
# DOCUMENT_PDF_TEXT_COMMAND=/usr/bin/pdftotext

# Optional trusted provider gateway; native provider adapters are not bundled.
# ECC_INTEGRATION_GATEWAY_URL=https://your-gateway.example/jobs
# ECC_INTEGRATION_GATEWAY_TOKEN=
# ECC_INTEGRATION_WEBHOOK_SECRET=
