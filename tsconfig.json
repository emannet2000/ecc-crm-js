{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force", "rootDir": ".", "outDir": "dist",
    "sourceMap": true, "declaration": true, "noEmitOnError": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["*.ts", "shared/**/*.ts", "frontend/**/*.tsx", "types/**/*.ts", "test/type-contracts.ts"],
  "exclude": ["node_modules", "dist", "browser"]
}
